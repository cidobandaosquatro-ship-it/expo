import React, { useState } from "react";
import { View, Text, TextInput, Button, ScrollView, Image, TouchableOpacity, Linking } from "react-native";
import * as ImagePicker from "expo-image-picker";

export default function App() {
  const [informadoPor, setInformadoPor] = useState("");
  const [descricao, setDescricao] = useState("");
  const [acoes, setAcoes] = useState("");
  const [data, setData] = useState("");
  const [hora, setHora] = useState("");
  const [unidade, setUnidade] = useState("");
  const [gerencia, setGerencia] = useState("");
  const [empresa, setEmpresa] = useState("");
  const [setor, setSetor] = useState("");
  const [area, setArea] = useState("");
  const [local, setLocal] = useState("");
  const [envolvido, setEnvolvido] = useState("");
  const [funcao, setFuncao] = useState("");
  const [tecnico, setTecnico] = useState("");
  const [evento, setEvento] = useState("");
  const [classificacao, setClassificacao] = useState("");
  const [comunicado24h, setComunicado24h] = useState("");
  const [imageUri, setImageUri] = useState(null);

  const pickImage = async () => {
    let permissionResult = await ImagePicker.requestMediaLibraryPermissionsAsync();
    if (permissionResult.granted === false) {
      alert("Permissão para acessar a galeria é necessária!");
      return;
    }

    let pickerResult = await ImagePicker.launchImageLibraryAsync({ quality: 0.5 });
    if (!pickerResult.canceled) {
      setImageUri(pickerResult.assets[0].uri);
    }
  };

  const takePhoto = async () => {
    let permissionResult = await ImagePicker.requestCameraPermissionsAsync();
    if (permissionResult.granted === false) {
      alert("Permissão para usar a câmera é necessária!");
      return;
    }
    let photoResult = await ImagePicker.launchCameraAsync({ quality: 0.5 });
    if (!photoResult.canceled) {
      setImageUri(photoResult.assets[0].uri);
    }
  };

  const shareWhatsApp = () => {
    const message =
      `🚨 *CPE - COMUNICAÇÃO PRELIMINAR DE EVENTOS* 🚨\n\n` +
      `📌 *INFORMADO POR:* ${informadoPor}\n\n` +
      `📝 *BREVE DESCRIÇÃO DO EVENTO:*\n${descricao}\n\n` +
      `✅ *AÇÕES IMEDIATAS:*\n${acoes}\n\n` +
      `📅 *DATA DO EVENTO:* ${data}\n` +
      `🕒 *HORÁRIO DO EVENTO:* ${hora}\n` +
      `🇧🇷 *UNIDADE DO EVENTO:* ${unidade}\n` +
      `📌 *GERÊNCIA:* ${gerencia}\n` +
      `🏭 *EMPRESA DO ENVOLVIDO:* ${empresa}\n` +
      `📌 *SETOR:* ${setor}\n` +
      `📌 *ÁREA:* ${area}\n` +
      `📍 *LOCAL:* ${local}\n` +
      `📌 *MATRÍCULA/NOME DO ENVOLVIDO:* ${envolvido}\n` +
      `📌 *FUNÇÃO DO ENVOLVIDO:* ${funcao}\n` +
      `▫️ *TÉCNICO DE SEGURANÇA:* ${tecnico}\n` +
      `⛔ *EVENTO:* ${evento}\n\n` +
      `⛔ *CLASSIFIQUE O ACIDENTE:* ${classificacao}\n\n` +
      `🔺 *AGUARDANDO CLASSIFICAÇÃO:*\n\n` +
      `*FOI COMUNICADO EM 24h?* ${comunicado24h}`;

    const url = `whatsapp://send?text=${encodeURIComponent(message)}`;
    Linking.openURL(url).catch(() => alert("Certifique-se de que o WhatsApp está instalado"));
  };

  return (
    <ScrollView style={{ padding: 20, backgroundColor: "#fff" }}>
      <Text style={{ fontWeight: "bold", fontSize: 18, marginBottom: 10 }}>CPE - Comunicação de Eventos</Text>
      <Text>Informado por:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={informadoPor} onChangeText={setInformadoPor} />

      <Text>Breve descrição do evento:</Text>
      <TextInput multiline style={{ borderWidth: 1, marginBottom: 10, padding: 8, height: 80 }} value={descricao} onChangeText={setDescricao} />

      <Text>Ações imediatas:</Text>
      <TextInput multiline style={{ borderWidth: 1, marginBottom: 10, padding: 8, height: 80 }} value={acoes} onChangeText={setAcoes} />

      <Text>Data do evento:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={data} onChangeText={setData} placeholder="dd/mm/aaaa" />

      <Text>Horário do evento:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={hora} onChangeText={setHora} placeholder="hh:mm" />

      <Text>Unidade do evento:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={unidade} onChangeText={setUnidade} />

      <Text>Gerência:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={gerencia} onChangeText={setGerencia} />

      <Text>Empresa do envolvido:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={empresa} onChangeText={setEmpresa} />

      <Text>Setor:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={setor} onChangeText={setSetor} />

      <Text>Área:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={area} onChangeText={setArea} />

      <Text>Local:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={local} onChangeText={setLocal} />

      <Text>Matrícula/Nome do envolvido:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={envolvido} onChangeText={setEnvolvido} />

      <Text>Função do envolvido:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={funcao} onChangeText={setFuncao} />

      <Text>Técnico de segurança:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={tecnico} onChangeText={setTecnico} />

      <Text>Evento:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={evento} onChangeText={setEvento} />

      <Text>Classifique o acidente:</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={classificacao} onChangeText={setClassificacao} />

      <Text>Foi comunicado em 24h?</Text>
      <TextInput style={{ borderWidth: 1, marginBottom: 10, padding: 8 }} value={comunicado24h} onChangeText={setComunicado24h} />

      <View style={{ flexDirection: "row", justifyContent: "space-between", marginBottom: 10 }}>
        <Button title="Selecionar Foto" onPress={pickImage} />
        <Button title="Tirar Foto" onPress={takePhoto} />
      </View>

      {imageUri && <Image source={{ uri: imageUri }} style={{ width: "100%", height: 200, marginBottom: 10 }} />}

      <Button title="Compartilhar no WhatsApp" onPress={shareWhatsApp} />
    </ScrollView>
  );
}
